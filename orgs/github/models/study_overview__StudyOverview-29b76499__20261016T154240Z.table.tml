{
  "model": {
    "columns": [
      {
        "column_id": "BRIEF_SUMMARIES::DESCRIPTION",
        "name": "Description",
        "properties": {
          "ai_context": "Detailed narrative explanation of the study's purpose, methodology, and objectives, providing comprehensive context for stakeholder understanding.",
          "column_type": "ATTRIBUTE",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Overview",
            "Details"
          ]
        }
      },
      {
        "formula_id": "formula_Study Count",
        "name": "Study Count",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Numerical count of clinical research studies for portfolio aggregation and statistical analysis across therapeutic research programs.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Research Number",
            "Experiment Total"
          ]
        }
      },
      {
        "formula_id": "formula_Average Enrollment",
        "name": "Average Enrollment",
        "properties": {
          "aggregation": "AVERAGE",
          "ai_context": "Average number of participants enrolled per study, useful for benchmarking recruitment performance across phases and therapeutic areas.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Mean Enrollment",
            "Avg Participants"
          ]
        }
      },
      {
        "formula_id": "formula_Study Duration (Days)",
        "name": "Study Duration (Days)",
        "properties": {
          "aggregation": "AVERAGE",
          "ai_context": "Calculated number of days between study start and completion dates, enabling timeline analysis and phase duration benchmarking.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Duration Days",
            "Trial Length Days"
          ]
        }
      },
      {
        "formula_id": "formula_Facility Count",
        "name": "Facility Count",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Total number of unique research facilities participating in studies, indicating trial operational complexity and geographic reach.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Site Count",
            "Number of Sites"
          ]
        }
      },
      {
        "formula_id": "formula_Country Count",
        "name": "Country Count",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Count of distinct countries where study sites are located, measuring the international scope and regulatory complexity of clinical programs.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX",
          "synonym_type": "AUTO_GENERATED",
          "synonyms": [
            "Number of Countries",
            "Geographic Reach"
          ]
        }
      },
      {
        "formula_id": "formula_Completion Rate",
        "name": "Completion Rate",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Percentage of enrolled participants who completed the study protocol, measuring retention and protocol adherence success rates.",
          "column_type": "MEASURE",
          "format_pattern": "#.##%",
          "index_type": "DONT_INDEX"
        }
      },
      {
        "formula_id": "formula_Active Studies",
        "name": "Active Studies",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Count of currently ongoing clinical trials in active recruitment, treatment, or follow-up phases within the research portfolio.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX"
        }
      },
      {
        "formula_id": "formula_Terminated Studies",
        "name": "Terminated Studies",
        "properties": {
          "aggregation": "SUM",
          "ai_context": "Count of clinical trials that were discontinued or stopped before completion due to safety, efficacy, or operational reasons.",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX"
        }
      },
      {

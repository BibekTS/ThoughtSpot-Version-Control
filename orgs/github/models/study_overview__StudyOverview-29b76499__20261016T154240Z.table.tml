      {
        "formula_id": "formula_Study Recruiting %",
        "name": "Study Recruiting %",
        "properties": {
          "aggregation": "SUM",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX"
        }
      },
      {
        "formula_id": "formula_Study Completed %",
        "name": "Study Completed %",
        "properties": {
          "aggregation": "SUM",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX"
        }
      },
      {
        "formula_id": "formula_Study Not Yet Recruiting %",
        "name": "Study Not Yet Recruiting %",
        "properties": {
          "aggregation": "SUM",
          "column_type": "MEASURE",
          "index_type": "DONT_INDEX"
        }
      },
      {
        "formula_id": "formula_Phase Label",
        "name": "Phase Label",
        "properties": {
          "ai_context": "Normalized display label for clinical trial phase, converting raw database values (e.g. PHASE1) to human-readable format (e.g. Phase 1) for consistent chart rendering.",
          "column_type": "ATTRIBUTE",
          "synonyms": [
            "Clinical Phase Label",
            "Phase Display Name"
          ]
        }
      },
      {
        "formula_id": "formula_Study Type Label",
        "name": "Study Type Label",
        "properties": {
          "ai_context": "Normalized display label for study type, converting raw uppercase values to title case for consistent chart rendering and reporting.",
          "column_type": "ATTRIBUTE",
          "synonyms": [
            "Study Category Label",
            "Research Type Display"
          ]
        }
      },
      {
        "formula_id": "formula_Why Stopped Bucket",
        "name": "Why Stopped Bucket",
        "properties": {
          "ai_context": "Standardized grouping of free-text termination reasons into meaningful categories for aggregate analysis and visualization.",
          "column_type": "ATTRIBUTE",
          "synonyms": [
            "Termination Category",
            "Stop Reason Group",
            "Termination Bucket"
          ]
        }
      }
    ],
    "filters": [
      {
        "column": [
          "Start Date"
        ],
        "oper": "between",
        "values": [
          "12/31/2021",
          "04/30/2026"
        ]
      }
    ],
    "formulas": [
      {
        "expr": "unique_count_if ( [STUDIES::OVERALL_STATUS] = 'recruiting' or [STUDIES::OVERALL_STATUS] = 'active_not_recruiting' , [STUDIES::NCT_ID] )",
        "id": "formula_Active Studies",
        "name": "Active Studies"
      },
      {
        "expr": "average ( [STUDIES::ENROLLMENT] )",
        "id": "formula_Average Enrollment",
        "name": "Average Enrollment"
      },
      {
        "expr": "safe_divide ( unique_count_if ( [STUDIES::OVERALL_STATUS] = 'completed' , [STUDIES::NCT_ID] ) , unique count ( [STUDIES::NCT_ID] ) )",
        "id": "formula_Completion Rate",
        "name": "Completion Rate"
      },
      {
        "expr": "unique count ( [COUNTRIES::NAME] )",
        "id": "formula_Country Count",
        "name": "Country Count"
      },
      {
        "expr": "unique count ( [FACILITIES::ID] )",
        "id": "formula_Facility Count",
        "name": "Facility Count"
      },
      {
        "expr": "if ( [STUDIES::PHASE] = 'phase1' ) then 'phase 1' else if ( [STUDIES::PHASE] = 'phase2' ) then 'phase 2' else if ( [STUDIES::PHASE] = 'phase3' ) then 'phase 3' else if ( [STUDIES::PHASE] = 'phase4' ) then 'phase 4' else if ( [STUDIES::PHASE] = 'phase1/phase2' ) then 'p1 / p2' else if ( [STUDIES::PHASE] = 'phase2/phase3' ) then 'p2 / p3' else if ( [STUDIES::PHASE] = 'early_phase1' ) then 'early p1' else 'no phase'",
        "id": "formula_Phase Label",
        "name": "Phase Label"
      },
      {
        "expr": "safe_divide ( unique_count_if ( [STUDIES::OVERALL_STATUS] = 'completed' , [STUDIES::NCT_ID] ) , unique count ( [STUDIES::NCT_ID] ) )",
        "id": "formula_Study Completed %",
        "name": "Study Completed %"
      },
      {
        "expr": "unique count ( [STUDIES::NCT_ID] )",
        "id": "formula_Study Count",
        "name": "Study Count"
      },
      {
        "expr": "diff_days ( [STUDIES::COMPLETION_DATE] , [STUDIES::START_DATE] )",
        "id": "formula_Study Duration (Days)",
        "name": "Study Duration (Days)"
      },
      {
        "expr": "safe_divide ( unique_count_if ( [STUDIES::OVERALL_STATUS] = 'not_yet_recruiting' , [STUDIES::NCT_ID] ) , unique count ( [STUDIES::NCT_ID] ) )",
        "id": "formula_Study Not Yet Recruiting %",
        "name": "Study Not Yet Recruiting %"
      },
      {
        "expr": "safe_divide ( unique_count_if ( [STUDIES::OVERALL_STATUS] = 'recruiting' , [STUDIES::NCT_ID] ) , unique count ( [STUDIES::NCT_ID] ) )",
        "id": "formula_Study Recruiting %",
        "name": "Study Recruiting %"
      },
      {
        "expr": "if ( [STUDIES::STUDY_TYPE] = 'interventional' ) then 'interventional' else if ( [STUDIES::STUDY_TYPE] = 'observational' ) then 'observational' else if ( [STUDIES::STUDY_TYPE] = 'expanded_access' ) then 'expanded access' else 'other'",
        "id": "formula_Study Type Label",
        "name": "Study Type Label"
      },
      {
        "expr": "unique_count_if ( [STUDIES::OVERALL_STATUS] = 'terminated' , [STUDIES::NCT_ID] )",
        "id": "formula_Terminated Studies",
        "name": "Terminated Studies"
      },
      {
        "expr": "if ( contains ( [STUDIES::WHY_STOPPED] , 'sponsor' ) or contains ( [STUDIES::WHY_STOPPED] , 'sponsor' ) ) then 'sponsor decision' else if ( contains ( [STUDIES::WHY_STOPPED] , 'business' ) or contains ( [STUDIES::WHY_STOPPED] , 'business' ) or contains ( [STUDIES::WHY_STOPPED] , 'strateg' ) or contains ( [STUDIES::WHY_STOPPED] , 'strateg' ) or contains ( [STUDIES::WHY_STOPPED] , 'priorit' ) or contains ( [STUDIES::WHY_STOPPED] , 'priorit' ) or contains ( [STUDIES::WHY_STOPPED] , 'portfolio' ) or contains ( [STUDIES::WHY_STOPPED] , 'portfolio' ) ) then 'business / strategic' else if ( contains ( [STUDIES::WHY_STOPPED] , 'recruit' ) or contains ( [STUDIES::WHY_STOPPED] , 'recruit' ) or contains ( [STUDIES::WHY_STOPPED] , 'accrual' ) or contains ( [STUDIES::WHY_STOPPED] , 'accrual' ) or contains ( [STUDIES::WHY_STOPPED] , 'enrollment' ) or contains ( [STUDIES::WHY_STOPPED] , 'enrollment' ) or contains ( [STUDIES::WHY_STOPPED] , 'enrolment' ) or contains ( [STUDIES::WHY_STOPPED] , 'enrolment' ) or contains ( [STUDIES::WHY_STOPPED] , 'participation' ) or contains ( [STUDIES::WHY_STOPPED] , 'participation' ) ) then 'low recruitment' else if ( contains ( [STUDIES::WHY_STOPPED] , 'fund' ) or contains ( [STUDIES::WHY_STOPPED] , 'fund' ) ) then 'lack of funding' else if ( contains ( [STUDIES::WHY_STOPPED] , 'futility' ) or contains ( [STUDIES::WHY_STOPPED] , 'futility' ) or contains ( [STUDIES::WHY_STOPPED] , 'efficacy' ) or contains ( [STUDIES::WHY_STOPPED] , 'efficacy' ) or contains ( [STUDIES::WHY_STOPPED] , 'benefit' ) or contains ( [STUDIES::WHY_STOPPED] , 'benefit' ) ) then 'futility / no efficacy' else if ( contains ( [STUDIES::WHY_STOPPED] , 'safety' ) or contains ( [STUDIES::WHY_STOPPED] , 'safety' ) or contains ( [STUDIES::WHY_STOPPED] , 'adverse' ) or contains ( [STUDIES::WHY_STOPPED] , 'adverse' ) or contains ( [STUDIES::WHY_STOPPED] , 'toxicity' ) or contains ( [STUDIES::WHY_STOPPED] , 'toxicity' ) ) then 'safety concerns' else if ( contains ( [STUDIES::WHY_STOPPED] , 'dsmb' ) or contains ( [STUDIES::WHY_STOPPED] , 'data safety' ) or contains ( [STUDIES::WHY_STOPPED] , 'data safety' ) ) then 'dsmb recommendation' else if ( [STUDIES::WHY_STOPPED] = null ) then 'not specified' else 'other'",
        "id": "formula_Why Stopped Bucket",
        "name": "Why Stopped Bucket"
      }
    ],
    "model_tables": [
      {
        "joins": [
          {
            "cardinality": "MANY_TO_ONE",
            "on": "[STUDIES::NCT_ID] = [BRIEF_SUMMARIES::NCT_ID]",
            "type": "INNER",
            "with": "BRIEF_SUMMARIES"
          },
          {
            "cardinality": "ONE_TO_MANY",
            "on": "[STUDIES::NCT_ID] = [COUNTRIES::NCT_ID]",
            "type": "INNER",
            "with": "COUNTRIES"
          },
          {
            "cardinality": "ONE_TO_MANY",
            "on": "[STUDIES::NCT_ID] = [FACILITIES::NCT_ID]",
            "type": "INNER",
            "with": "FACILITIES"
          },
          {
            "cardinality": "ONE_TO_MANY",
            "on": "[STUDIES::NCT_ID] = [MILESTONES::NCT_ID]",
            "type": "INNER",
            "with": "MILESTONES"
          }

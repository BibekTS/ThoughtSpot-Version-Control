            "custom_visual_props": "{\"code\":\"const { muze, getDataFromSearchQuery } \\u003d viz;\\nconst data \\u003d getDataFromSearchQuery();\\nconst c \\u003d {\\u0027Phase 1\\u0027:\\u0027#14B8A6\\u0027,\\u0027Phase 2\\u0027:\\u0027#6366F1\\u0027,\\u0027Phase 3\\u0027:\\u0027#8B5CF6\\u0027,\\u0027Phase 4\\u0027:\\u0027#F43F5E\\u0027,\\u0027P1 / P2\\u0027:\\u0027#2DD4BF\\u0027,\\u0027P2 / P3\\u0027:\\u0027#F59E0B\\u0027,\\u0027Early P1\\u0027:\\u0027#0EA5E9\\u0027,\\u0027No phase\\u0027:\\u0027#94A3B8\\u0027};\\nconst fields \\u003d data.getFieldspace().fields.map(f \\u003d\\u003e f.name());\\nconst phaseField \\u003d fields.find(f \\u003d\\u003e f.includes(\\u0027Phase\\u0027)) || \\u0027Phase Label\\u0027;\\nconst crField \\u003d fields.find(f \\u003d\\u003e f.includes(\\u0027Completion\\u0027) || f.includes(\\u0027Rate\\u0027)) || \\u0027Completion Rate\\u0027;\\nconst aeField \\u003d fields.find(f \\u003d\\u003e f.includes(\\u0027Enrollment\\u0027) || f.includes(\\u0027enrollment\\u0027)) || \\u0027Average Enrollment\\u0027;\\nconst scField \\u003d fields.find(f \\u003d\\u003e f.includes(\\u0027Count\\u0027) || f.includes(\\u0027count\\u0027)) || \\u0027Study Count\\u0027;\\nmuze.canvas()\\n  .rows([aeField])\\n  .columns([crField])\\n  .detail([phaseField])\\n  .layers([{\\n    mark: \\u0027point\\u0027,\\n    encoding: {\\n      size: {\\n        field: scField,\\n        scale: { type: \\u0027linear\\u0027, domain: [0, 100000], range: [80, 1800] }\\n      },\\n      color: { field: phaseField, value: (d) \\u003d\\u003e c[d] || \\u0027#94A3B8\\u0027 },\\n      opacity: { value: () \\u003d\\u003e 0.8 }\\n    }\\n  }])\\n  .config({\\n    axes: {\\n      x: { name: \\u0027Completion Rate\\u0027 },\\n      y: { name: \\u0027Avg Enrollment\\u0027 }\\n    },\\n    legend: { color: { show: false } }\\n  })\\n  .data(data)\\n  .mount(\\u0027#chart\\u0027);\"}",
